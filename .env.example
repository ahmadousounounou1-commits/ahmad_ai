# ============================================================
# AHMAD AI : fichier de configuration (modèle)
# 1) Copie ce fichier et renomme la copie en  .env
# 2) Remplis les valeurs ci-dessous
# 3) Ne partage JAMAIS ton fichier .env (il contient ta clé secrète)
# ============================================================

# --- Choix de l'IA -----------------------------------------
# auto      : utilise l'IA externe si une clé est donnée, sinon le mode local
# anthropic : force l'IA externe (erreur au démarrage si la clé est vide)
# local     : mode local sans Internet (petit assistant à règles, pas une vraie IA)
AI_PROVIDER=auto

# Ta clé API (à créer sur https://console.anthropic.com). Nécessite Internet.
# L'API est payante à l'usage : vérifie les tarifs sur le site.
ANTHROPIC_API_KEY=

# Modèle utilisé (tu peux le changer sans toucher au code)
AI_MODEL=claude-sonnet-5

# --- Informations du créateur (affichées sur la page Contact) ---
CREATOR_NAME=Ahmadou
CONTACT_EMAIL=
CONTACT_WHATSAPP=

# --- Limites (protègent ton budget et ton serveur) ---------
MAX_OUTPUT_TOKENS=1000
MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_PER_HOUR=40

# --- Développement local uniquement ---
# 1 = rechargement automatique + messages d'erreur détaillés.
# NE PAS mettre 1 en ligne (production).
FLASK_DEBUG=1

# --- En ligne uniquement (Render, etc.) ---
# 1 quand l'application est derrière le proxy de l'hébergeur
# TRUST_PROXY=1
